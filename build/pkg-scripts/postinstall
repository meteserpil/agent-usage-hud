#!/bin/sh

# Installer scripts run as root. Hand off the user-specific Claude setup to
# the person logged into the Mac so the app writes to their home directory.
console_user=$(/usr/bin/stat -f%Su /dev/console 2>/dev/null || true)
case "$console_user" in
  ""|root|loginwindow) exit 0 ;;
esac

user_home=$(/usr/bin/dscl . -read "/Users/$console_user" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
user_id=$(/usr/bin/id -u "$console_user" 2>/dev/null || true)
app_path="${3%/}${2%/}/Agent Usage HUD.app"
app_executable="$app_path/Contents/MacOS/Agent Usage HUD"

if [ -z "$user_home" ] || [ -z "$user_id" ] || [ ! -x "$app_executable" ]; then
  exit 0
fi

if /bin/launchctl asuser "$user_id" /usr/bin/sudo -u "$console_user" /usr/bin/env \
  HOME="$user_home" USER="$console_user" LOGNAME="$console_user" \
  "$app_executable" --setup-claude >/dev/null 2>&1; then
  exit 0
else
  setup_status=$?
fi

case "$setup_status" in
  2)
    message='Claude Code setup was skipped because ~/.claude/settings.json contains invalid JSON. Fix the file, then run the installer again.' ;;
  3)
    message='Claude Code already has a different status line. The installer left it unchanged. Merge the HUD command with your existing status line, then run the installer again.' ;;
  4)
    message='A Claude HUD status line helper already exists and was left unchanged. Review ~/.claude/agent-usage-hud-statusline.js, then run the installer again.' ;;
  *)
    message='Claude Code setup could not finish. Existing settings were left unchanged. Open Agent Usage HUD and check the Claude setup message.' ;;
esac

/bin/launchctl asuser "$user_id" /usr/bin/sudo -u "$console_user" /usr/bin/osascript \
  -e "display dialog \"$message\" buttons {\"OK\"} default button \"OK\" with icon caution" \
  >/dev/null 2>&1 || true

exit 0
