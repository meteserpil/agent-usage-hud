{
  "name": "agent-usage-hud",
  "version": "1.1.8",
  "description": "Toggleable overlay showing Claude Code, Codex, Cursor and Antigravity usage and limits. Local-only, read-only.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:win:x64": "electron-builder --win --x64",
    "dist:win:arm64": "electron-builder --win --arm64"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.15.3"
  },
  "private": true,
  "build": {
    "appId": "com.meteserpil.agentusagehud",
    "productName": "Agent Usage HUD",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!build/icon-*.png",
      "!build/icon.png",
      "!build/icon-render-*/**",
      "!build/icon-transparent-*/**",
      "!build/render-icon.cjs",
      "!build/package-icons.cjs"
    ],
    "electronLanguages": ["en-US"],
    "extraResources": [
      {
        "from": "claude-statusline.js",
        "to": "claude-statusline.js"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "12.0.0",
      "target": [
        {
          "target": "pkg"
        }
      ],
      "artifactName": "Agent-Usage-HUD-${version}-${arch}.${ext}"
    },
    "pkg": {
      "installLocation": "/Applications",
      "scripts": "pkg-scripts"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Agent-Usage-HUD-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Usage HUD",
      "deleteAppDataOnUninstall": false
    }
  }
}
