{
  "name": "agent-usage-hud",
  "version": "1.1.5",
  "description": "Toggleable overlay showing Claude Code, Codex, Cursor and Antigravity usage and limits. Local-only, read-only.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "43.8.0",
    "electron-builder": "26.15.3"
  },
  "private": true,
  "build": {
    "appId": "com.meteserpil.agentusagehud",
    "productName": "Agent Usage HUD",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "claude-statusline.js",
        "to": "claude-statusline.js"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "12.0.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Agent-Usage-HUD-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Agent-Usage-HUD-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Usage HUD",
      "deleteAppDataOnUninstall": false
    }
  }
}
